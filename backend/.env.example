# ─────────────────────────────────────────────────────────────────
#  Viharasetu API — environment
#  Copy to .env and fill in.  NEVER commit .env.
# ─────────────────────────────────────────────────────────────────

# ── MySQL connection ─────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=viharasetu
DB_USER=
DB_PASSWORD=
DB_POOL=10
# Set DB_SSL=true for managed MySQL that requires TLS (PlanetScale, some
# Railway/Aiven plans). Leave DB_SSL_REJECT_UNAUTHORIZED=true unless the
# provider gives a self-signed cert and explicitly tells you otherwise.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ── API server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Comma-separated list of browser origins allowed to call this API.
# Must include every origin the site is served from.
CORS_ORIGINS=https://viharasetu.co.in,https://www.viharasetu.co.in

# Admin session lifetime in hours (old Apps Script token was 6h).
SESSION_TTL_HOURS=6

# bcrypt cost factor for admin password hashing.
BCRYPT_ROUNDS=12

# ── Public-form bot protection (src/antiSpam.js) ─────────────────
# Secret used to sign form tokens. Use a long random string (e.g. `openssl rand -hex 32`).
# If empty, a random secret is generated at each boot and tokens reset on restart.
# Authenticator-app (Microsoft Authenticator) MFA. Encrypts each user's TOTP secret and signs the
# short sign-in challenge. REQUIRED in production - generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable: changing it makes every enrolled user re-enrol.
MFA_ENC_KEY=
FORM_TOKEN_SECRET=

# Optional CAPTCHA: Cloudflare Turnstile (free). Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile, put the SECRET key here and
# the SITE key in js/enquiry-guard.js (VS_TURNSTILE_SITEKEY). Leave empty to keep it off.
TURNSTILE_SECRET_KEY=

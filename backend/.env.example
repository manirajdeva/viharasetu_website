# ─────────────────────────────────────────────────────────────────
#  Viharasetu API — environment
#  Copy to .env and fill in.  NEVER commit .env.
# ─────────────────────────────────────────────────────────────────

# ── MySQL connection ─────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=viharasetu
DB_USER=
DB_PASSWORD=
DB_POOL=10
# Set DB_SSL=true for managed MySQL that requires TLS (PlanetScale, some
# Railway/Aiven plans). Leave DB_SSL_REJECT_UNAUTHORIZED=true unless the
# provider gives a self-signed cert and explicitly tells you otherwise.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ── API server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Comma-separated list of browser origins allowed to call this API.
# Must include every origin the site is served from.
CORS_ORIGINS=https://viharasetu.co.in,https://www.viharasetu.co.in

# Admin session lifetime in hours (old Apps Script token was 6h).
SESSION_TTL_HOURS=6

# bcrypt cost factor for admin password hashing.
BCRYPT_ROUNDS=12
